# Required — 32+ random characters, used to sign session JWTs
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Comma-separated list of Ethereum addresses allowed to access the docs
# Addresses are case-insensitive (normalized to lowercase for comparison)
ALLOWED_ADDRESSES=0xYourAddress,0xAnotherAddress

# Optional — chain to connect to (1 = mainnet, 11155111 = Sepolia)
NEXT_PUBLIC_CHAIN_ID=1

# Optional — custom RPC URL
NEXT_PUBLIC_RPC_URL=
